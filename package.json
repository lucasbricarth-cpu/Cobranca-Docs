{
  "name": "portal-documentos",
  "version": "0.1.0",
  "private": true,
  "description": "Portal de documentos do escritório de contabilidade: ponta do funcionário e ponta do cliente, num único PWA.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "paletas": "node --no-warnings --experimental-strip-types scripts/gerar-paletas-css.ts",
    "contraste": "node --no-warnings --experimental-strip-types scripts/checar-contraste.ts",
    "migrar": "node --no-warnings --experimental-strip-types scripts/migrar.ts",
    "semear": "node --no-warnings --experimental-strip-types scripts/semear.ts",
    "capturas": "node --no-warnings --experimental-strip-types scripts/capturas.ts",
    "job:diario": "node --no-warnings --experimental-strip-types scripts/jobs/diario.ts",
    "job:fila": "node --no-warnings --experimental-strip-types scripts/jobs/fila.ts",
    "postinstall": "node scripts/copiar-bibliotecas.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-ses": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@napi-rs/canvas": "^1.0.10",
    "@simplewebauthn/browser": "^13.1.0",
    "@simplewebauthn/server": "^13.1.1",
    "archiver": "^7.0.1",
    "fast-xml-parser": "^4.5.0",
    "lucide-react": "^0.468.0",
    "next": "14.2.35",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "^0.33.5",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@techstark/opencv-js": "^5.0.0-release.1",
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "playwright": "^1.56.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
