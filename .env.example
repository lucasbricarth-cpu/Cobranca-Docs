# ── Banco (Postgres) ──
DATABASE_URL=postgres://portal:portal@127.0.0.1:5432/portal
DATABASE_URL_TEST=postgres://portal:portal@127.0.0.1:5432/portal_test

# ── App ──
APP_URL=http://localhost:3000
# Segredo para assinar cookies de sessão, links mágicos e URLs de download. Gere com: openssl rand -hex 32
APP_SECRET=troque-este-segredo
# Chave que autoriza as rotas /api/jobs/* (cron externo) e o leitor da Domínio.
JOB_SECRET=troque-este-segredo
LEITOR_DOMINIO_TOKEN=troque-este-segredo
# Nome do escritório (aparece em e-mails e no PWA)
ESCRITORIO_NOME=Escritório Contábil

# ── Armazenamento dos arquivos ──
# local = pasta ./armazenamento (desenvolvimento). s3 = bucket compatível com S3 em São Paulo (produção).
ARMAZENAMENTO=local
S3_BUCKET=
S3_REGION=sa-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
LIMITE_ARQUIVO_MB=25

# ── Antivírus ──
# clamav = usa clamdscan (ClamAV) antes de o arquivo aparecer. nenhum = só desenvolvimento.
ANTIVIRUS=nenhum

# ── E-mail ──
# log = só escreve no log (desenvolvimento). ses = Amazon SES pelo domínio do escritório (SPF, DKIM, DMARC).
EMAIL=log
EMAIL_REMETENTE="Escritório <documentos@escritorio.com.br>"
SES_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Push (Web Push, VAPID). Gere com: npx web-push generate-vapid-keys ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:documentos@escritorio.com.br

# ── IA (classificação de foto e PDF; só tipo e subtipo) ──
# nenhum = sem sugestão (tudo vai para A conferir). simulada = heurística local, só para desenvolvimento.
# gemini = Gemini 2.5 Flash via Vertex AI (southamerica-east1). Use VERTEX_ACCESS_TOKEN ou GOOGLE_APPLICATION_CREDENTIALS (conta de serviço).
IA=nenhum
VERTEX_PROJECT=
VERTEX_LOCATION=southamerica-east1
VERTEX_MODEL=gemini-2.5-flash
VERTEX_ACCESS_TOKEN=

# ── WhatsApp (plataforma de atendimento ligada ao número oficial) ──
# simulado = adaptador de teste. plataforma = adaptador da plataforma escolhida ([DECIDIR], ver docs/whatsapp.md)
WHATSAPP=simulado
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_NUMERO_ESCRITORIO=5511999999999
# Mensagens-modelo automáticas por dia (subir aos poucos no piloto, olhando a classificação de qualidade do número).
WHATSAPP_LIMITE_DIARIO=50
# Espera depois do último arquivo para fechar o lote (o cliente costuma mandar vários seguidos).
WHATSAPP_ESPERA_LOTE_MS=30000
# Sem resposta a uma pergunta em tantas horas: os arquivos vão para "Não reconhecidos" e o atendente segue.
WHATSAPP_PRAZO_RESPOSTA_H=4

# ── Passkeys (WebAuthn) ──
RP_ID=localhost
RP_NAME=Portal de Documentos

# ── Guarda (Etapa 9). O app nunca apaga sozinho: o job lista o que venceu e um Admin aprova. ──
# [DECIDIR] prazo da pasta geral (arquivos sem empresa), em dias desde o recebimento.
PASTA_GERAL_PRAZO_DIAS=90
# Aviso aos Admins, em dias, antes de vencer a pasta geral.
PASTA_GERAL_AVISO_DIAS=7
# Guarda dos Não reconhecidos de uma empresa (sem tipo), em meses. Os tipos têm o prazo deles em Ajustes › Tipos.
GUARDA_SEM_TIPO_MESES=60
