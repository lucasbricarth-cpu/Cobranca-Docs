# ── Conexão com o banco da Domínio (SQL Anywhere), por ODBC ──
# Usuário EXCLUSIVO do leitor, com permissão só de SELECT e só nas tabelas
# listadas em sql/criar-usuario-leitura.sql. Nunca use o usuário da Domínio.
DOMINIO_DRIVER=odbc
DOMINIO_ODBC="DSN=Contabil;UID=leitor_portal;PWD=troque-esta-senha"

# ── Envio para o app (de dentro para fora; o app nunca chama o leitor) ──
APP_URL=https://documentos.escritorio.com.br
LEITOR_DOMINIO_TOKEN=troque-este-token

# ── Conta encerrada (ctcontas.SITUACAO_CTA) ──
# A ligação entre CTCONTACAIXA_CONTA_BANCARIA.I_CONTA_CAIXA e ctcontas.codi_cta
# está A CONFIRMAR na Domínio. Enquanto não for confirmada, deixe vazio.
# Exemplo (só depois de confirmar):
# DOMINIO_SQL_ENCERRADAS="SELECT c.CODI_EMP, c.I_CONTA_CAIXA FROM CTCONTACAIXA_CONTA_BANCARIA c JOIN ctcontas t ON t.codi_emp = c.CODI_EMP AND t.codi_cta = c.I_CONTA_CAIXA WHERE t.SITUACAO_CTA = 'I'"
DOMINIO_SQL_ENCERRADAS=
